<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.qiany.basic.module.search.dal.mysql.song.IndexSongMapper">

    <!--
        一般情况下，尽可能使用 Mapper 进行 CRUD 增删改查即可。
        无法满足的场景，例如说多表关联查询，才使用 XML 编写 SQL。
        代码生成器暂时只生成 Mapper XML 文件本身，更多推荐 MybatisX 快速开发插件来生成查询。
        文档可见：https://www.iocoder.cn/MyBatis/x-plugins/
     -->

    <select id="selectSyncList" resultType="cn.qiany.basic.module.search.dal.dataobject.song.IndexSongDO">
        SELECT
            id,
            org_id,
            name,
            singer_ids,
            singer_names,
            album_names,
            hot,
            is_copyright,
            invalidate,
            is_enabled,
            first_start_state,
            release_date,
            update_time
        FROM index_song
        WHERE deleted = 0
          AND id > #{lastId}
        ORDER BY id ASC
            LIMIT #{batchSize};
    </select>

    <select id="selectSyncCount" resultType="java.lang.Long">
        SELECT COUNT(*)
        FROM index_song
        WHERE deleted = 0
    </select>

</mapper>